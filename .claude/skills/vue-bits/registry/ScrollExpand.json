{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ScrollExpand",
  "title": "ScrollExpand",
  "description": "A rounded media frame that grows to full bleed as it scrolls through the viewport.",
  "type": "registry:component",
  "files": [
