{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "GradientText",
	"title": "GradientText",
	"description": "Living gradients inside your text: a sliding sweep, a drifting mesh or a swinging conic fan.",
	"type": "registry:component",
